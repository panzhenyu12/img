{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://img.local/schemas/edit-graph.schema.json",
  "title": "Non-destructive edit graph",
  "type": "object",
  "required": ["version", "sourceAssetId", "operations"],
  "properties": {
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "sourceAssetId": { "type": "string", "minLength": 1 },
    "operations": {
      "type": "array",
      "items": { "$ref": "operation.schema.json" }
    }
  },
  "additionalProperties": false
}
