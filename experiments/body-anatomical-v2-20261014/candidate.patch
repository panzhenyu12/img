+/// Source-conditioned thigh change with a 26%-of-radius upper bound.
+/// Its derivative is in (-0.85, 0.85), so radius ± change(radius) both preserve
+/// strict source ordering. The excess has zero tangent at the knee reference.
+fn thigh_radius_change(radius: f32, joint_radius: f32) -> f32 {
+    let excess = (radius - joint_radius).abs();
+    let rounding = (joint_radius * 0.04).max(1.0);
+    let geometric = 0.85 * excess * excess / (excess + rounding);
+    let limit = radius * 0.26;
+    // C1 minimum with a fixed 0.5px transition. Using a fixed width keeps
+    // its derivative a convex mixture of the two monotone branch slopes.
+    let band = 0.5;
+    if geometric <= limit - band { geometric }
+    else if limit <= geometric - band { limit }
+    else { ((geometric + limit) * 0.5 - (geometric - limit).powi(2) / (4.0 * band) - band * 0.25).max(0.0) }
+}
+
+/// Evidence changes continuously with the measured contour. A cylinder or
+/// an unmeasurable knee retains a working legacy width control; a clear taper
+/// uses the source-order-preserving target. Intermediate confidence is not
+/// claimed to have the fully active model's no-new-extrema guarantee.
+fn thigh_source_evidence(sections: &[(f32,f32)]) -> ((f32,f32), f32) {
+    let mut joint = [0.0f32;2];
+    let mut reliability = [0.0f32;2];
+    for side in 0..2 {
+        let values: Vec<f32> = sections[56..=61].iter()
+            .map(|s| if side == 0 { s.0 } else { s.1 }).collect();
+        joint[side] = values.iter().copied().fold(0.0, f32::max);
+        let support = values.iter().map(|r| smoothstep(0.0,2.0,*r)).sum::<f32>();
+        reliability[side] = smoothstep(2.0,4.0,support);
+    }
+    let excess = sections[14..=48].iter().map(|&(a,b)| (a-joint[0]).max(b-joint[1]))
+        .fold(0.0,f32::max);
+    let scale = joint[0].max(joint[1]);
+    let confidence = smoothstep((scale*0.04).max(1.0),(scale*0.12).max(3.0),excess)
+        * reliability[0].min(reliability[1]);
+    ((joint[0],joint[1]),confidence)
+}
