+        for (i, &target) in targets.iter().enumerate() {
+            if target {
+                assert_eq!(&a.pixels[i * 4..i * 4 + 4], &b.pixels[i * 4..i * 4 + 4]);
+                assert!(a.pixels[i * 4 + 3] > 0 && a.pixels[i * 4 + 3] < 255);
+                assert!(a.pixels[i * 4].abs_diff(220) <= 1);
+                assert!(a.pixels[i * 4 + 1].abs_diff(55) <= 1);
+            }
+        }
