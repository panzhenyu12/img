     #[test]
+    fn narrow_strip_recovers_affine_background_without_quantization_drift() {
+        let (w, h) = (64usize, 48usize);
+        let mut pixels = Vec::new();
+        let mut targets = vec![false; w * h];
+        for y in 0..h {
+            for x in 0..w {
+                targets[y * w + x] = (20..30).contains(&x) && (5..43).contains(&y);
+                pixels.extend_from_slice(&[
+                    40 + x as u8 * 2 + y as u8,
+                    60 + x as u8 + y as u8 * 2,
+                    100 + x as u8,
+                    255,
+                ]);
+            }
+        }
+        let truth = RgbaImage::new(w as u32, h as u32, pixels).unwrap();
+        let mut source = truth.clone();
+        for (i, &target) in targets.iter().enumerate() {
+            if target {
+                source.pixels[i * 4..i * 4 + 3].copy_from_slice(&[20, 30, 40]);
+            }
+        }
+        let filled = reconstruct_narrow_strip(&source, &targets, &vec![false; w * h]).unwrap();
+        let mut max_error = 0;
+        for (i, &target) in targets.iter().enumerate() {
+            if target {
+                for c in 0..3 {
+                    max_error =
+                        max_error.max(filled.pixels[i * 4 + c].abs_diff(truth.pixels[i * 4 + c]));
+                }
+            } else {
+                assert_eq!(
+                    &filled.pixels[i * 4..i * 4 + 4],
+                    &source.pixels[i * 4..i * 4 + 4]
+                );
+            }
+        }
+        assert!(
+            max_error <= 1,
+            "quantized diffusion lost affine continuation: max error {max_error}"
+        );
+    }
