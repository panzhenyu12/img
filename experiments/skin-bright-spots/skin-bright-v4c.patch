+/// A pale, raised spot needs a different test from a dark/red defect. Require
+/// a compact luminance bump *and* a loss of the surrounding skin's red-green
+/// chroma. An additive lighting highlight keeps that chroma and is excluded;
+/// large or near-white highlights are excluded as well. This conservative
+/// statistic is not a medical classifier and cannot identify every whitehead.
+fn skin_bright_spots(
+    source: &RgbaImage,
+    selection: &LocalSelection,
+    medium: &[[f32; 3]],
+    structure: &[f32],
+    face_width: f32,
+    blemish: &mut [([f32; 3], f32)],
+) {
+    let width = selection.width as usize;
+    let height = selection.height as usize;
+    let color = |i: usize| -> [f32; 3] {
+        let index = ((i / width + selection.y as usize) * source.width as usize
+            + i % width
+            + selection.x as usize)
+            * 4;
+        std::array::from_fn(|c| source.pixels[index + c] as f32)
+    };
+    let mut residual = vec![0.0; width * height];
+    let mut paleness = vec![0.0; width * height];
+    let mut candidates = vec![false; width * height];
+    for i in 0..candidates.len() {
+        if selection.weights[i].1 <= 0.5 || structure[i] <= 0.7 {
+            continue;
+        }
+        let rgb = color(i);
+        let light = luma(rgb[0], rgb[1], rgb[2]);
+        let baseline = luma(medium[i][0], medium[i][1], medium[i][2]);
+        let pale = (medium[i][0] - medium[i][1]) - (rgb[0] - rgb[1]);
+        residual[i] = light - baseline;
+        paleness[i] = pale;
+        candidates[i] = residual[i] > 14.0 && pale > 11.0 && light < 205.0;
+    }
+    let max_radius = (face_width * 0.016).clamp(3.0, 11.0);
+    let min_radius = (face_width * 0.0035).clamp(1.4, 2.4);
+    let min_area = (std::f32::consts::PI * min_radius.powi(2)).round() as usize;
+    let max_area = (std::f32::consts::PI * max_radius.powi(2)) as usize;
+    let padding = (face_width * 0.02).round().clamp(5.0, 14.0) as usize;
+    let mut visited = vec![false; candidates.len()];
+    for start in 0..candidates.len() {
+        if !candidates[start] || visited[start] {
+            continue;
+        }
+        visited[start] = true;
+        let mut component = vec![start];
+        let mut cursor = 0;
+        let mut bounds = [start % width, start / width, start % width, start / width];
+        let mut safe = true;
+        while cursor < component.len() {
+            let i = component[cursor];
+            cursor += 1;
+            let (x, y) = (i % width, i / width);
+            bounds[0] = bounds[0].min(x);
+            bounds[1] = bounds[1].min(y);
+            bounds[2] = bounds[2].max(x);
+            bounds[3] = bounds[3].max(y);
+            for ny in y.saturating_sub(1)..=(y + 1).min(height - 1) {
+                for nx in x.saturating_sub(1)..=(x + 1).min(width - 1) {
+                    let j = ny * width + nx;
+                    safe &= selection.weights[j].1 > 0.5;
+                    if candidates[j] && !visited[j] {
+                        visited[j] = true;
+                        component.push(j);
+                    }
+                }
+            }
+        }
+        let span_x = bounds[2] - bounds[0] + 1;
+        let span_y = bounds[3] - bounds[1] + 1;
+        let peak = component.iter().map(|&i| residual[i]).fold(0.0, f32::max);
+        if !safe
+            || component.len() < min_area
+            || component.len() > max_area
+            || peak < 18.0
+            || span_x.max(span_y) as f32 > span_x.min(span_y) as f32 * 2.4
+            || component.len() as f32 / ((span_x * span_y) as f32) < 0.35
+        {
+            continue;
+        }
+        let mut sum = [0.0; 3];
+        let mut count = 0.0;
+        for y in bounds[1].saturating_sub(padding)..=(bounds[3] + padding).min(height - 1) {
+            for x in bounds[0].saturating_sub(padding)..=(bounds[2] + padding).min(width - 1) {
+                let i = y * width + x;
+                if (x + 2 >= bounds[0]
+                    && x <= bounds[2] + 2
+                    && y + 2 >= bounds[1]
+                    && y <= bounds[3] + 2)
+                    || selection.weights[i].1 <= 0.5
+                    || candidates[i]
+                    || structure[i] < 0.8
+                {
+                    continue;
+                }
+                let rgb = color(i);
+                let difference =
+                    luma(rgb[0], rgb[1], rgb[2]) - luma(medium[i][0], medium[i][1], medium[i][2]);
+                // Only observed, unprotected skin with ordinary local detail
+                // donates. Nearby pale bumps and dark pores do not set tone.
+                if difference.abs() > 8.0 {
+                    continue;
+                }
+                let weight = selection.weights[i].1;
+                for c in 0..3 {
+                    sum[c] += rgb[c] * weight;
+                }
+                count += weight;
+            }
+        }
+        if count < 12.0 {
+            continue;
+        }
+        let tone = sum.map(|v| v / count);
+        let core: [f32; 3] = std::array::from_fn(|c| {
+            component.iter().map(|&i| color(i)[c]).sum::<f32>() / component.len() as f32
+        });
+        // A same-colored specular bump is lighting, not a pale blemish.
+        if (tone[0] - tone[1]) - (core[0] - core[1]) < 7.0
+            || luma(core[0], core[1], core[2]) - luma(tone[0], tone[1], tone[2]) < 18.0
+        {
+            continue;
+        }
+        // Classification chooses the spot, while continuous photometric
+        // weights choose the repair. A binary component boundary or a fully
+        // replaced core would leave a flat disk with a visible edge.
+        for y in bounds[1].saturating_sub(3)..=(bounds[3] + 3).min(height - 1) {
+            for x in bounds[0].saturating_sub(3)..=(bounds[2] + 3).min(width - 1) {
+                let i = y * width + x;
+                if selection.weights[i].1 <= 0.5 || structure[i] <= 0.7 {
+                    continue;
+                }
+                let amount =
+                    smoothstep(4.0, 50.0, residual[i]) * smoothstep(1.0, 12.0, paleness[i]);
+                if amount > blemish[i].1 {
+                    blemish[i] = (tone, amount);
+                }
+            }
+        }
+    }
+}
