+    #[test]
+    fn bright_spot_classifier_rejects_wide_specular_light_and_protected_donors() {
+        let mut source = pale_spot_fixture();
+        for y in 16usize..40 {
+            for x in 16usize..60 {
+                source.pixels[(y * 192 + x) * 4..(y * 192 + x) * 4 + 3]
+                    .copy_from_slice(&[245, 240, 235]);
+            }
+        }
+        let params = json!({"protectMask":{"shape":"rect","region":{
+            "x":0.65,"y":0.35,"width":0.15,"height":0.3}}});
+        let selection = LocalSelection::skin(&source, &params, None);
+        let detail = skin_detail_planes(&source, &selection, source.width as f32);
+        assert_eq!(
+            detail.blemish[64 * 192 + 136].1,
+            0.0,
+            "frozen bump must not be classified or donate"
+        );
+        assert_eq!(
+            detail.blemish[28 * 192 + 38].1,
+            0.0,
+            "wide near-white specular area is not a spot"
+        );
+        let output = crate::mask::composite(
+            &source,
+            &skin(
+                &source,
+                &json!({"smooth":100,"texture":0,"protectMask":params["protectMask"]}),
+            ),
+            &params,
+        );
+        for y in 45usize..80 {
+            for x in 126usize..149 {
+                let i = (y * 192 + x) * 4;
+                assert_eq!(&output.pixels[i..i + 4], &source.pixels[i..i + 4]);
+            }
+        }
+    }
