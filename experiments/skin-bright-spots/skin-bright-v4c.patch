+    #[test]
+    fn pale_compact_bump_is_repaired_without_erasing_same_chroma_highlight_or_small_pore() {
+        let source = pale_spot_fixture();
+        let selection = LocalSelection::skin(&source, &json!({}), None);
+        let detail = skin_detail_planes(&source, &selection, source.width as f32);
+        let center = 64 * source.width as usize + 136;
+        let highlight = 64 * source.width as usize + 40;
+        let pore = 64 * source.width as usize + 80;
+        assert!(
+            detail.blemish[center].1 > 0.2,
+            "pale raised bump must be a candidate"
+        );
+        assert_eq!(
+            detail.blemish[highlight].1, 0.0,
+            "same-chroma illumination must not be a blemish"
+        );
+        assert_eq!(
+            detail.blemish[pore].1, 0.0,
+            "low-contrast pore must not be a blemish"
+        );
+        let output = skin(&source, &json!({"smooth":100,"texture":100}));
+        let original_contrast = pixel_light(&source, center) - pixel_light(&source, center + 16);
+        let edited_contrast = pixel_light(&output, center) - pixel_light(&output, center + 16);
+        assert!(edited_contrast <= original_contrast * 0.65);
+        assert!((pixel_light(&output, highlight) - pixel_light(&source, highlight)).abs() < 4.0);
+        assert!((pixel_light(&output, pore) - pixel_light(&source, pore)).abs() < 3.0);
+        assert!(output.pixels.chunks_exact(4).all(|p| p[3] == 173));
+    }
