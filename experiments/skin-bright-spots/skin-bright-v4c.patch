+    fn pale_spot_fixture() -> RgbaImage {
+        RgbaImage::new(
+            192,
+            128,
+            (0..128)
+                .flat_map(|y| {
+                    (0..192).flat_map(move |x| {
+                        let bump = |cx: f32, cy: f32, spread: f32| {
+                            (-((x as f32 - cx).powi(2) + (y as f32 - cy).powi(2)) / spread).exp()
+                        };
+                        let pale = bump(136.0, 64.0, 14.0);
+                        let raised_shadow = bump(136.0, 64.0, 38.0);
+                        let highlight = bump(40.0, 64.0, 8.0);
+                        let pore = bump(80.0, 64.0, 2.0);
+                        [
+                            byte(
+                                170.0 - 30.0 * raised_shadow
+                                    + 35.0 * pale
+                                    + 35.0 * highlight
+                                    + 5.0 * pore,
+                            ),
+                            byte(
+                                130.0 - 30.0 * raised_shadow
+                                    + 75.0 * pale
+                                    + 35.0 * highlight
+                                    + 8.0 * pore,
+                            ),
+                            byte(
+                                110.0 - 30.0 * raised_shadow
+                                    + 65.0 * pale
+                                    + 35.0 * highlight
+                                    + 8.0 * pore,
+                            ),
+                            173,
+                        ]
+                    })
+                })
+                .collect(),
+        )
+        .unwrap()
+    }
