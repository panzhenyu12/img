+    fn contour_inverse_preserves_texture_slopes_and_never_folds_at_extreme_widths() {
+        for radius in [40.0f32, 200.0, 5.0, 1.0] {
+            for amount in [-1.0f32, -0.6, 0.6, 1.0] {
+                let profile = ContourProfile {
+                    warp: Warp {
+                        axis: Axis {
+                            origin: (0.0, 0.0),
+                            direction: (0.0, 1.0),
+                            length: 100.0,
+                            radius,
+                        },
+                        amount,
+                        center: 0.5,
+                        extent: 0.5,
+                        limb: true,
+                    },
+                    sections: vec![(radius, radius); 65],
+                    section_anchors: vec![(1.0, 1.0); 65],
+                    fringe: 4.0,
+                };
+                // At the middle section the requested physical width is
+                // exactly ±26%, independently of image resolution.
+                let target = radius * (1.0 - amount * 0.26);
+                let core = radius * 0.30;
+                for sign in [-1.0f32, 1.0] {
+                    let input = |r: f32| {
+                        let x = sign * r;
+                        sign * (x + profile.displacement((x, 50.0)).0)
+                    };
+                    assert!((input(target) - radius).abs() < 1e-4 * radius.max(1.0));
+                    assert!((input(core) - core).abs() < 1e-5);
+                    let mut previous = input(0.0);
+                    for i in 1..=2000 {
+                        let output = (radius.max(target) + 2.0) * i as f32 / 2000.0;
+                        let current = input(output);
+                        assert!(current > previous, "inverse folded: radius={radius}, amount={amount}, at {output}");
+                        previous = current;
+                    }
+                    // A stripe crossing the fixed core or silhouette must
+                    // retain one continuous tangent, including expansion.
+                    // The old piecewise affine inverse failed this contract.
+                    let epsilon = radius * 0.001;
+                    for join in [core, target] {
+                        let left = (input(join) - input(join - epsilon)) / epsilon;
+                        let right = (input(join + epsilon) - input(join)) / epsilon;
+                        assert!((left - right).abs() < 0.02,
+                            "texture tangent jumped: radius={radius}, amount={amount}, join={join}, slopes={left}/{right}");
+                    }
+                }
+            }
+        }
+    }
