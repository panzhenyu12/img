+/// Experimental color supply refinement. Keep the original integer class
+/// map and reconstruction classification front unchanged. Only uncertain
+/// observed neck/hair RGB donors receive colors propagated from the same
+/// observed class's pure interior; the original output layer is untouched.
+fn purify_layer_donor_colors(
+    source: &RgbaImage,
+    observed_layer: &[u8],
+    pure: &[bool],
+    forbidden: &[bool],
+) -> RgbaImage {
+    let w = source.width as usize;
+    let h = source.height as usize;
+    let n = w * h;
+    let mut known: Vec<bool> = (0..n)
+        .map(|i| observed_layer[i] > 0 && pure[i] && !forbidden[i])
+        .collect();
+    let mut queue = VecDeque::new();
+    for i in 0..n {
+        if known[i] { queue.push_back(i); }
+    }
+    let mut out = source.clone();
+    while let Some(i) = queue.pop_front() {
+        for j in neighbors(i,w,h) {
+            if known[j] || forbidden[j] || observed_layer[j] == 0
+                || observed_layer[j] != observed_layer[i] {
+                continue;
+            }
+            let mut color = [0.0_f32; 4];
+            let mut count = 0;
+            for k in neighbors(j,w,h).filter(|&k|
+                known[k] && !forbidden[k] && observed_layer[k] == observed_layer[j]) {
+                let a=out.pixels[k*4+3] as f32/255.0;
+                for c in 0..3 { color[c] += out.pixels[k*4+c] as f32*a; }
+                color[3] += a;
+                count += 1;
+            }
+            if count == 0 { continue; }
+            for c in 0..3 {
+                out.pixels[j*4+c]=if color[3]>1e-6 { byte(color[c]/color[3]) } else {0};
+            }
+            out.pixels[j*4+3]=byte(color[3]/count as f32*255.0);
+            known[j]=true;
+            queue.push_back(j);
+        }
+    }
+    // No same-class pure donor path means no claimed clean reconstruction;
+    // retain that original observation for this control experiment. Never
+    // borrow a neighboring material or change the classification geometry.
+    out
+}
